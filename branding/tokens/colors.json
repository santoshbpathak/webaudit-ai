  "status": {
    "$description": "Fixed scale, identical in both themes. Never colour alone: always icon + label (see WEBAUDIT_AI_BRAND_GUIDELINES.md §14).",
    "critical": {
      "$value": "#D03B3B",
      "icon": "octagon-alert",
      "label": "Critical"
    },
    "high": {
      "$value": "#EC835A",
      "icon": "triangle-alert",
      "label": "High"
    },
    "medium": {
      "$value": "#FAB219",
      "icon": "circle-alert",
      "label": "Medium"
    },
    "low": {
      "$value": "#4C8DF6",
      "icon": "info",
      "label": "Low"
    },
    "info": {
      "$value": "#8A94A6",
      "icon": "circle-dot",
      "label": "Informational"
    },
    "passed": {
      "$value": "#16A06B",
      "icon": "circle-check",
      "label": "Passed"
    },
    "notTested": {
      "$value": "#6B778A",
      "icon": "circle-dashed",
      "label": "Not tested",
      "pattern": "45deg hatch"
    }
  },
  "chart": {
    "$description": "Categorical order is fixed (never cycled). Validated with the dataviz palette validator: lightness band, chroma floor, adjacent CVD \u0394E \u2265 8 and normal-vision \u0394E \u2265 15 pass in both modes. Light mode slots 1, 5, 6 are below 3:1 on white: charts must carry visible labels or a table view.",
    "light": ["#1BAF7A", "#2A78D6", "#EB6834", "#6250D6", "#EDA100", "#E87BA4"],
    "dark": ["#199E70", "#3987E5", "#D95926", "#9085E9", "#C98500", "#D55181"],
    "sequential": ["#E6FAF4", "#B5EEDD", "#7BE8CB", "#2EC9A3", "#14A586", "#0B7A66", "#06392F"]
  },
  "theme": {
    "dark": {
      "canvas": {
        "$value": "#0B1220",

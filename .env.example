# Copy to .env (never commit it). Everything here is optional; the app runs with none of it.
# Placeholders only — never put real values in this file.

# Where the SQLite DB and artifacts live (default: <repo>/data)
# WEBAUDIT_DATA_DIR=./data

# Required when the app is reachable from a network (Docker, cloud). 16+ random chars,
# e.g. `openssl rand -hex 24`.
# WEBAUDIT_ACCESS_TOKEN=

# Interface for `next start` / the container (default 127.0.0.1; the container uses 0.0.0.0
# and then requires WEBAUDIT_ACCESS_TOKEN).
# WEBAUDIT_HOST=127.0.0.1

# Without a token, only loopback Host headers are accepted (DNS-rebinding defence).
# Add hostnames here if you front a local instance with a reverse proxy.
# WEBAUDIT_ALLOWED_HOSTS=audit.lan

# Read-only demo serving bundled sample audits (scanning and AI disabled).
# WEBAUDIT_DEMO=1

# Development/testing only: permit private hosts such as a local fixture site.
# WEBAUDIT_ALLOW_PRIVATE_HOSTS=127.0.0.1

# Chromium's renderer sandbox is on by default. Set to 1 only where the sandbox cannot start
# (e.g. Docker's default seccomp profile); see docs/security.md.
# WEBAUDIT_CHROME_NO_SANDBOX=1

# Optional AI (off unless set). Keys are read server-side only.
# WEBAUDIT_AI_PROVIDER=anthropic        # or: openai
# ANTHROPIC_API_KEY=
# WEBAUDIT_ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# WEBAUDIT_OPENAI_MODEL=llama3.1
# Spend guard: maximum AI calls stored per audit (default 20).
# WEBAUDIT_AI_MAX_CALLS_PER_AUDIT=20
